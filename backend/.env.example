# 复制为 backend/.env 后填写密钥。解析、下载和字幕提取不需要密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 使用 secrets.token_urlsafe(48) 在本机生成，不使用占位值启动。
JWT_SECRET=
DATABASE_PATH=backend/data/app.db
# 本地单条下载与队列临时文件目录；Docker由Compose覆盖为容器路径。
DOWNLOAD_DIR=backend/downloads
# 本地语音转写可选开启；先安装requirements-asr.txt并显式准备模型。
ASR_ENABLED=false
# 固定使用 small / CPU / int8。
ASR_MODEL_DIR=backend/models/faster-whisper-small
ASR_CPU_THREADS=4
# 支付默认只允许测试环境。真实收款须另外授权并准备正式商户环境。
PAYMENT_MODE=test
PAYMENT_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_VIP_30D=
FRONTEND_URL=http://127.0.0.1:5173
# 仅当本地代理将公网域名解析为 198.18.0.0/15 Fake-IP 时设为 true；部署默认保持关闭。
# 只允许域名解析得到的该地址段；字面 IP、本地地址和其他内网地址仍被拒绝。
ALLOW_PROXY_FAKE_IP=false
